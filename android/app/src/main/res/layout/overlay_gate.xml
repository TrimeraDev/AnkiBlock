<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="40dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/gate_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="@color/on_surface_variant"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gate_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Study first. Unlock later."
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gate_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/gate_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/card_elevated" />

            <TextView
                android:id="@+id/gate_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />

            <Button
                android:id="@+id/gate_btn_study"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/gradient_button_background"
                android:text="Study in AnkiDroid"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/gate_btn_bypass"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Hold for emergency bypass"
                android:textAllCaps="false"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/gate_bypass_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="6dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/on_surface_variant"
                android:progressBackgroundTint="@color/card_elevated"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/gate_bypass_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <Button
                android:id="@+id/gate_btn_open_ankiblock"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Open AnkiBlock"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
